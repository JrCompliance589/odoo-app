<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_nyife" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nyife</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Nyife WhatsApp" string="Nyife WhatsApp" data-key="nyife_whatsapp">
                    <block title="Nyife API Configuration" name="nyife_api_settings">
                        <setting string="Enable WhatsApp Notifications" help="Activate automatic WhatsApp notification sending via Nyife">
                            <field name="nyife_enabled"/>
                        </setting>
                        <setting string="Nyife Instance URL" help="Enter your Nyife instance URL">
                            <field name="nyife_api_url" placeholder="https://your-domain.nyife.chat"/>
                        </setting>
                        <setting string="API Access Token" help="Enter the API access token from your Nyife dashboard">
                            <field name="nyife_access_token" password="True"/>
                        </setting>
                    </block>
                    <block title="Actions" name="nyife_actions">
                        <setting string="Test Connection" help="Verify your Nyife API credentials">
                            <button name="action_test_nyife_connection"
                                    type="object"
                                    string="Test Connection"
                                    class="btn-primary"
                                    icon="fa-plug"/>
                        </setting>
                        <setting string="Sync Templates" help="Fetch approved WhatsApp templates from your Nyife account">
                            <button name="action_sync_nyife_templates"
                                    type="object"
                                    string="Sync Templates"
                                    class="btn-secondary"
                                    icon="fa-refresh"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
