<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- Pre-defined event types as data records (for reference) -->
    <!-- These are selection values, no separate model needed -->

    <!-- Scheduled action for activity due today notifications -->
    <record id="nyife_cron_activity_due" model="ir.cron">
        <field name="name">Nyife: Send Activity Due Today Notifications</field>
        <field name="model_id" ref="model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">
leads = env['crm.lead'].search([
    ('activity_ids.date_deadline', '=', fields.Date.today()),
])
if leads:
    leads._trigger_nyife_event('activity_due_today')
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
