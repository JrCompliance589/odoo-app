<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template Tree View -->
    <record id="nyife_template_view_tree" model="ir.ui.view">
        <field name="name">nyife.template.tree</field>
        <field name="model">nyife.template</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Templates">
                <field name="name"/>
                <field name="language"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'rejected'"/>
                <field name="header_text"/>
                <field name="body_text" widget="text"/>
            </tree>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="nyife_template_view_form" model="ir.ui.view">
        <field name="name">nyife.template.form</field>
        <field name="model">nyife.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="nyife_id" readonly="1"/>
                            <field name="nyife_uuid" readonly="1"/>
                            <field name="language" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" readonly="1" widget="badge"
                                   decoration-success="status == 'approved'"
                                   decoration-warning="status == 'pending'"
                                   decoration-danger="status == 'rejected'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <group>
                                <field name="header_text" readonly="1"/>
                                <field name="body_text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Raw Data" name="raw_data">
                            <group>
                                <field name="components_json" readonly="1" widget="text"/>
                                <field name="variables_json" readonly="1" widget="text"/>
                            </group>
                        </page>
                        <page string="Event Actions" name="event_actions">
                            <field name="event_action_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="event_type"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Template Action -->
    <record id="nyife_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">nyife.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No templates synced yet
            </p>
            <p>
                Go to Settings → Nyife WhatsApp and click "Sync Templates" to fetch your approved WhatsApp templates from Nyife.
            </p>
        </field>
    </record>

</odoo>
