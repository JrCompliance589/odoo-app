<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Send Message Wizard Form -->
    <record id="nyife_send_message_wizard_view_form" model="ir.ui.view">
        <field name="name">nyife.send.message.wizard.form</field>
        <field name="model">nyife.send.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="template_id"/>
                    <field name="phone_field"/>
                    <field name="phone_preview" readonly="1"/>
                </group>
                <separator string="Template Preview"/>
                <group>
                    <field name="body_preview" readonly="1"/>
                </group>
                <separator string="Template Variables"/>
                <field name="variable_line_ids">
                    <tree editable="bottom">
                        <field name="component_type" readonly="1"/>
                        <field name="variable_index" readonly="1"/>
                        <field name="value" placeholder="Enter value for this variable"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_send" type="object" string="Send Message" class="btn-primary" icon="fa-paper-plane"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
